[Unit]
Description=Crossword Generator
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/crossword
EnvironmentFile=/var/www/crossword/.env
ExecStart=/var/www/crossword/venv/bin/gunicorn crossword_project.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
